<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <Platforms>x64</Platforms>
    <Configurations>Debug;Release</Configurations>

    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    
    <PackageId>Gossamer</PackageId>
    <Version>0.0.1</Version>

    <!-- Get rid of the "netX.X" in the output path -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- References -->
  <ItemGroup>
    <Using Include="System.Numerics" />
  </ItemGroup>

  <!-- Embedded -->
  <ItemGroup>
    <EmbeddedResource Include="Backend/Text/ProggyClean.ttf" />
  </ItemGroup>

  <!-- Dependency binaries for Windows -->
  <ItemGroup Condition=" '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' ">
    <!-- GLFW -->
    <None Update="External/libgossamer-glfw.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- FreeType -->
    <None Update="External/libgossamer-freetype.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- HarfBuzz -->
    <None Update="External/libgossamer-harfbuzz.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Vulkan Memory Allocator -->
    <None Update="External/libgossamer-vma.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Dependency binaries for Linux -->
  <ItemGroup Condition=" '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' ">
    <!-- GLFW -->
    <None Update="External/libgossamer-glfw.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- FreeType -->
    <None Update="External/libgossamer-freetype.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- HarfBuzz -->
    <None Update="External/libgossamer-harfbuzz.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Vulkan Memory Allocator -->
    <None Update="External/libgossamer-vma.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
