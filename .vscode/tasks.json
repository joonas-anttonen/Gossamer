{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build",
			"detail": "Builds the solution in debug mode",
			"problemMatcher": "$msCompile",
			"type": "process",
			"command": "dotnet",
			"args": [
				"build",
				"${workspaceFolder}/Gossamer.sln",
				"/p:Configuration=Debug",
				"/p:Platform=x64",
			]
		},
		{
			"label": "Compile Shaders",
			"detail": "Compiles the shaders in the Backend/Shaders folder",
			"problemMatcher": "$msCompile",
			"type": "shell",
			"command": "${workspaceFolder}/Gossamer.GfxCompiler/bin/x64/Release/Gossamer.GfxCompiler.exe",
			"args": [
				"${workspaceFolder}/Gossamer/Backend/Shaders",
				"${workspaceFolder}/Gossamer/Backend/Shaders/built-in.shaders"
			]
		}
	]
}