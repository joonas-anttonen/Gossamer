{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Gossamer Debug",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/Gossamer.sln",
				"/p:Configuration=Debug",
				"/p:Platform=x64",
				"/p:GenerateFullPaths=true"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Build Gossamer.GfxCompiler Release",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/Gossamer.GfxCompiler/Gossamer.GfxCompiler.sln",
				"/p:Configuration=Release",
				"/p:Platform=x64",
				"/p:GenerateFullPaths=true"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Master Build Gossamer Debug",
			"problemMatcher": "$msCompile",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Build Gossamer.GfxCompiler Release",
				"Build Gossamer Debug"
			],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": true
			}
		}
	]
}